# ==============================================================================
# H2-VQE-Topology-Benchmark: Environment Configuration
# Qiskit Fall Hackathon 2026 — SRM University AP
# Track 1: Quantum Chemistry (PS-C1: H2 Ground-State Energy Estimation)
# ==============================================================================

# Python execution settings
PYTHONPATH=.
PYTHONUNBUFFERED=1

# Molecular Hamiltonian parameters
MOLECULE=H2
BOND_DISTANCE=0.74
BASIS_SET=sto-3g
MAPPER=jordan_wigner

# VQE optimization parameters
OPTIMIZER=COBYLA
MAX_ITER=35
SHOTS=4096
SEED=42

# Circuit synthesis & compilation settings
OPTIMIZATION_LEVEL=1
ROUTING_SEED=42
ENTANGLEMENT=full
REPS=2

# Official synthetic noise model (GenericBackendV2)
P1_ERROR=0.001
P2_ERROR=0.005
PRO_ERROR=0.010

# Zero-Noise Extrapolation (ZNE) error mitigation
ENABLE_ZNE=true
ZNE_SCALE_FACTORS=1,3,5

# Qubit-Wise Commuting (QWC) measurement grouping
ENABLE_QWC=true

# Multi-molecule chemical transferability benchmark
ENABLE_MULTI_MOLECULE=true

# Dynamical Decoupling (DD) sequence (CPMG or XY4)
DD_SEQUENCE=XY4

# Directories
RESULTS_DIR=results
FIGURES_DIR=results/figures
TABLES_DIR=results/tables
LOG_LEVEL=INFO
